<?xml version="1.0" encoding="utf-8"?>
<!--
    Logo-free alternative to ic_launcher_foreground: swap it in if using the VirusTotal mark
    becomes a problem.
    108x108 adaptive-icon canvas; the artwork is scaled to 80% around the center so launchers
    leave a comfortable margin around it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedResources"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8">
        <path
            android:pathData="M35,28 H63 L73,38 V80 H35 Z M63,28 V38 H73"
            android:strokeColor="@color/icon_foreground"
            android:strokeWidth="2.2"
            android:strokeLineJoin="miter"
            android:fillColor="#00000000" />
    </group>
</vector>
